{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/assets/i1.jpg",
        "width": 30,
        "height": 15,
        "padding": {
            "top": 2,
            "right": 2
        }
    },
    "display": {
        "separator": " -> ",
        "color": {
            "separator": "green"
        },
        "constants": [
            "────────────────────────────────────────────────────────────",
            "\u001b[62D",
            "\u001b[61C",
            "\u001b[60C",
            "════════════════════════════════════════════════════════════"
        ]
    },
    "modules": [
        { "type": "custom", "format": "┌{$1}┐", "outputColor": "36" },
        { "type": "title", "format": "{$3}│{$2}│ {user-name-colored}{at-symbol-colored}{host-name-colored}" },
        { "type": "custom", "format": "└{$1}┘", "outputColor": "36" },
        { "type": "custom", "format": "╔{$5}╗", "outputColor": "31" },
        {
            "type": "os",
            "key": "{$3}║{$2}║ \uf303 OS",
            "keyColor": "red",
            "format": "{2}"
        },
        {
            "type": "kernel",
            "key": "{$3}║{$2}║ ├\uf013",
            "keyColor": "red"
        },
        {
            "type": "packages",
            "key": "{$3}║{$2}║ ├\udb80\udfd6",
            "keyColor": "red"
        },
        {
            "type": "terminal",
            "key": "{$3}║{$2}║ ├\uf120",
            "keyColor": "red"
        },
        {
            "type": "shell",
            "key": "{$3}║{$2}║ └\uf489",
            "keyColor": "red"
        },
        { "type": "custom", "format": "╟{$1}╢", "outputColor": "34" },
        {
            "type": "custom",
            "key": "{$3}║{$2}║ \udb80\udf22 PC",
            "keyColor": "blue",
            "format": "Desktop"
        },
        {
            "type": "cpu",
            "key": "{$3}║{$2}║ ├\udb83\udee0",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "{$3}║{$2}║ ├\udb80\udf5b",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "{$3}║{$2}║ ├\udb81\udc6d",
            "keyColor": "blue"
        },
        {
            "type": "swap",
            "key": "{$3}║{$2}║ ├\udb81\udce1",
            "keyColor": "blue"
        },
        {
            "type": "display",
            "key": "{$3}║{$2}║ ├\udb80\udf79",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "{$3}║{$2}║ └\udb80\udd50",
            "keyColor": "blue"
        },
        { "type": "custom", "format": "╚{$5}╝", "outputColor": "34" }
    ]
}
